# ==============================================================================
# CodeGuardian Backend - Environment Variables
# ==============================================================================
# Copy this file to .env and provide your secret credentials.

# ------------------------------------------------------------------------------
# 1. Django Core Configuration
# ------------------------------------------------------------------------------
SECRET_KEY=django-insecure-codeguardian-mvp-super-secret-key-development
DEBUG=True
ALLOWED_HOSTS=*

# Database: Uses SQLite by default for development. 
# For PostgreSQL in production, use: postgres://user:password@localhost:5432/codeguardian
DATABASE_URL=sqlite:///db.sqlite3

# ------------------------------------------------------------------------------
# 2. Celery & Asynchronous Task Processing
# ------------------------------------------------------------------------------
# Set to True to run scan jobs synchronously in the request (ideal for local testing without Redis)
# Set to False to dispatch scans to Celery workers via Redis
CELERY_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. AI Remediation Providers (Google Gemini / OpenAI / Ollama / Mock)
# ------------------------------------------------------------------------------
# AI Provider selection: "gemini" | "openai" | "ollama" | "mock"
# If left blank, it automatically detects whichever API key is set below.
AI_PROVIDER=gemini

# --- Google Gemini API (Recommended) ---
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=AQ.Ab8RN6Lk_VdHcw893lN3_jvrBuvLbf6cqH3F_zkboAC9qpMYBw
GEMINI_MODEL=gemini-1.5-flash

# --- OpenAI API (Alternative) ---
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# --- Local Ollama (Offline / Air-gapped) ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 4. GitHub Integration & Webhooks
# ------------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret_here
